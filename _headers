/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'

/tongue/*
  Cache-Control: public, max-age=2592000

/data/cases/*
  Cache-Control: public, max-age=300, must-revalidate

# Service Worker 必须每次重新验证：否则新版本部署后浏览器可能一直拿旧 sw.js，
# PWA 更新链路会整体失效。no-cache 不是不缓存，而是每次用条件请求校验（304 成本很低）。
/sw.js
  Cache-Control: no-cache

# manifest 同理，名称 / 图标 / start_url 调整后应能被及时发现。
/manifest.webmanifest
  Cache-Control: no-cache
